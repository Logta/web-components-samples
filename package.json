{
  "name": "web-components-samples",
  "version": "1.0.0",
  "private": true,
  "description": "Web Components samples with Vanilla JS, Lit, and React",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:react": "pnpm --filter @demo/react dev",
    "dev:vanilla": "pnpm --filter @demo/vanillajs dev",
    "build": "pnpm -r build",
    "preview": "pnpm -r preview",
    "typecheck": "pnpm -r typecheck",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "check": "biome check --write .",
    "check:ci": "biome ci ."
  },
  "keywords": [
    "web-components",
    "vite",
    "lit",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@melt-ui/pp": "^0.3.2",
    "@storybook/web-components": "10.6.1",
    "@storybook/web-components-vite": "10.6.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-react": "^5.1.2",
    "storybook": "10.6.1",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:"
  },
  "pnpm": {
    "packageExtensions": {
      "@headlessui/react": {
        "peerDependencies": {
          "@types/react": "*",
          "@types/react-dom": "*"
        }
      }
    }
  }
}
