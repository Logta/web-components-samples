{
  "name": "@web-components-samples/lit",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./react": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./wc": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && pnpm build:wc && pnpm build:react && pnpm build:bundle",
    "build:wc": "tsc && vite build",
    "build:react": "tsc && vite build --config vite.config.react.ts",
    "build:bundle": "tsc && vite build --config vite.config.bundle.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "@lit/react": "^1.0.8"
  },
  "devDependencies": {
    "vite": "catalog:",
    "react": "catalog:",
    "@types/react": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}
