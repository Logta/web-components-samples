{
  "name": "@web-components-samples/lit-tailwind",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./react": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./wc": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && pnpm build:wc && pnpm build:react && pnpm build:bundle",
    "build:wc": "tsc && vite build",
    "build:react": "tsc && vite build --config vite.config.react.ts",
    "build:bundle": "tsc && vite build --config vite.config.bundle.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@zag-js/core": "^1.31.1",
    "@zag-js/dialog": "^1.32.0",
    "@zag-js/menu": "^1.32.0",
    "@zag-js/toggle": "^1.31.1",
    "@zag-js/types": "^1.32.0",
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tailwindcss": "^4.1.18",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}