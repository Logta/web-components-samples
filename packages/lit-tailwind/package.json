{
  "name": "@web-components-samples/lit-tailwind",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lit": {
      "types": "./dist/counter/counter.d.ts",
      "import": "./dist/counter/counter.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.config.bundle.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "lit": "^3.1.0",
    "@lit/react": "^1.0.5"
  },
  "devDependencies": {
    "vite": "^7.3.0",
    "typescript": "^5.9.3",
    "tailwindcss": "^4.1.18",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "react": "^19.2.3",
    "@types/react": "^19.2.7"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}